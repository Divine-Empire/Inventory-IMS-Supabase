datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "auth"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

//-------------------------------------------
//* USER MODEL
//-------------------------------------------
model User {
  id String @id @default(uuid())

  username String @unique
  fullName String
  password String
  role     String

  pageAccess     String?
  locationAccess String? // CSV of ims_location_master.locationCode this user can see; null = all

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ims_User")
  @@schema("public")
}

//-------------------------------------------
//* ITEM MASTER
//-------------------------------------------
// itemCode is the cross-system business key. It should match
// pfms_item_master."ITEM CODE" (Purchase-FMS-Supabase) so PFMS-sourced
// indent/PO/receiving data can be joined without a cross-DB FK. Not
// declared as a Prisma relation to pfms_item_master because that table
// is owned/migrated by a different project against the same physical DB.
model ItemMaster {
  id String @id @default(uuid())

  itemCode  String  @unique
  itemName  String
  itemGroup String? // CSV "GROUP"
  category  String?
  uom       String?
  hsnCode   String?
  imageUrl  String? // CSV "IMAGE" — column reserved, upload/display deferred to a later batch

  standardCost        Float? // last/avg purchase cost, feeds valuation + profitability
  standardPrice       Float? // last known selling rate, fallback when no sales history
  orderingCost        Float? // cost per PO placed, for EOQ
  holdingCostPct      Float? // annual holding cost as % of unit cost, for EOQ
  defaultLeadTimeDays Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locationSettings   ItemLocationSetting[]
  stockLedger        StockLedger[]
  serialNumbers      SerialNumber[]
  indentPoSync       IndentPoSync[]
  stockTransferItems StockTransferItem[]
  salesTransactions  SalesTransaction[]
  abcSnapshots       AbcSnapshot[]

  @@map("ims_item_master")
  @@schema("public")
}

//-------------------------------------------
//* ITEM x LOCATION SETTINGS (per-location levels)
//-------------------------------------------
// Max Level, reorder inputs and average peak sale are set per
// item+location (matches the legacy Google-Sheet IMS, which had a
// separate reorder formula per CG/NE/Maniquip/Head Office). Opening
// LIVE STOCK from the CSV import is NOT stored here — it is written as
// an "OPENING" row in ims_stock_ledger so live stock stays a single
// source of truth.
model ItemLocationSetting {
  id String @id @default(uuid())

  itemCode String
  item     ItemMaster @relation(fields: [itemCode], references: [itemCode])

  locationId String
  location   LocationMaster @relation(fields: [locationId], references: [id])

  minLevel     Float?
  maxLevel     Float? // CSV "MAX LEVEL (PEAK)"
  reorderLevel Float?
  safetyStock  Float?
  avgSalePeak  Float? // CSV "AVG SALE (PEAK)"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemCode, locationId])
  @@map("ims_item_location_setting")
  @@schema("public")
}

//-------------------------------------------
//* LOCATION MASTER
//-------------------------------------------
// Fixed set today: CG, NE, MANIQUIP, HO (Head Office) — matches the
// warehouseLocation values already in use in PFMS's IndentGeneration
// and the existing Google-Sheet-backed IMS page.
model LocationMaster {
  id String @id @default(uuid())

  locationCode String  @unique
  locationName String
  address      String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locationSettings  ItemLocationSetting[]
  stockLedger       StockLedger[]
  serialNumbers     SerialNumber[]
  indentPoSync      IndentPoSync[]
  salesTransactions SalesTransaction[]
  transfersFrom     StockTransfer[]       @relation("TransferFrom")
  transfersTo       StockTransfer[]       @relation("TransferTo")

  @@map("ims_location_master")
  @@schema("public")
}

//-------------------------------------------
//* STOCK LEDGER (source of truth for live stock)
//-------------------------------------------
// Live Stock for an item+location = SUM(qty) of ims_stock_ledger rows,
// signed by txnType (IN/TRANSFER_IN/ADJUSTMENT(+) vs OUT/TRANSFER_OUT/
// ADJUSTMENT(-)). Never stored as a running column, to avoid drift.
model StockLedger {
  id String @id @default(uuid())

  itemCode String
  item     ItemMaster @relation(fields: [itemCode], references: [itemCode])

  locationId String
  location   LocationMaster @relation(fields: [locationId], references: [id])

  txnType  String // IN | OUT | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT
  qty      Float
  serialNo String?

  referenceType String? // PO | Indent | Sale | Transfer | Adjustment
  referenceNo   String?
  balanceAfter  Float?
  remarks       String?
  createdBy     String?

  createdAt DateTime @default(now())

  @@index([itemCode, locationId])
  @@index([referenceType, referenceNo])
  @@map("ims_stock_ledger")
  @@schema("public")
}

//-------------------------------------------
//* SERIAL NUMBER TRACKING (warranty + IN/OUT validation)
//-------------------------------------------
model SerialNumber {
  id String @id @default(uuid())

  itemCode String
  item     ItemMaster @relation(fields: [itemCode], references: [itemCode])

  serialNo String @unique

  currentLocationId String?
  currentLocation   LocationMaster? @relation(fields: [currentLocationId], references: [id])

  status String @default("IN_STOCK") // IN_STOCK | OUT | TRANSFERRED

  // Captured at INN time: warranty expiry if applicable, else invoice date
  warrantyExpiryDate DateTime?
  invoiceDate        DateTime?

  inTxnId  String? // ims_stock_ledger.id of the INN that created this serial
  outTxnId String? // ims_stock_ledger.id of the OUT that consumed this serial

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemCode, status])
  @@map("ims_serial_number")
  @@schema("public")
}

//-------------------------------------------
//* PFMS SYNC: INDENT / PO / IN-TRANSIT SNAPSHOT
//-------------------------------------------
// Upserted by a scheduled sync job from PFMS's pfms_for_ims +
// pfms_material-received, keyed by indentNo (PFMS's own business key).
model IndentPoSync {
  id String @id @default(uuid())

  indentNo String      @unique
  itemCode String?
  item     ItemMaster? @relation(fields: [itemCode], references: [itemCode])

  // PFMS's own warehouseLocation string, resolved to our LocationMaster.
  locationId String?
  location   LocationMaster? @relation(fields: [locationId], references: [id])

  indentQty    Float?
  poNumber     String?
  poQty        Float?
  intransitQty Float?
  receivedQty  Float?
  leadTimeDays Int?

  plannedDeliveryDate DateTime?
  actualDeliveryDate  DateTime?

  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ims_indent_po_sync")
  @@schema("public")
}

//-------------------------------------------
//* STOCK TRANSFER (location to location)
//-------------------------------------------
model StockTransfer {
  id String @id @default(uuid())

  transferNo String @unique

  fromLocationId String
  fromLocation   LocationMaster @relation("TransferFrom", fields: [fromLocationId], references: [id])

  toLocationId String
  toLocation   LocationMaster @relation("TransferTo", fields: [toLocationId], references: [id])

  status      String  @default("pending") // pending | in_transit | received | cancelled
  requestedBy String?
  approvedBy  String?
  receivedBy  String?
  remarks     String?

  items StockTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ims_stock_transfer")
  @@schema("public")
}

model StockTransferItem {
  id String @id @default(uuid())

  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  itemCode String
  item     ItemMaster @relation(fields: [itemCode], references: [itemCode])

  qty           Float
  serialNumbers String[] @default([])

  createdAt DateTime @default(now())

  @@map("ims_stock_transfer_item")
  @@schema("public")
}

//-------------------------------------------
//* SALES SYNC (from OTP make-invoice / LTO quotation items)
//-------------------------------------------
// Upserted by scheduled sync jobs. One row per item per invoice.
// rate/amount come from lto_make_quotation_items (real per-line value,
// not grand_total divided by item count); invoiceNo/invoiceDate/qty
// confirm the sale actually happened via otp_make_invoice.
model SalesTransaction {
  id String @id @default(uuid())

  quotationNo String?
  itemCode    String?
  item        ItemMaster? @relation(fields: [itemCode], references: [itemCode])
  itemNameRaw String? // as received before itemCode reconciliation

  qty    Float?
  rate   Float?
  amount Float?

  invoiceNo   String?
  invoiceDate DateTime?

  locationId String?
  location   LocationMaster? @relation(fields: [locationId], references: [id])

  sourceSystem String? // OTP | LTO

  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemCode, invoiceDate])
  @@map("ims_sales_transaction")
  @@schema("public")
}

//-------------------------------------------
//* ABC CLASSIFICATION + EOQ SNAPSHOT
//-------------------------------------------
model AbcSnapshot {
  id String @id @default(uuid())

  itemCode String
  item     ItemMaster @relation(fields: [itemCode], references: [itemCode])

  period String // e.g. "2026-09" (monthly) or "2026-Q3"

  revenue  Float
  qtySold  Float
  cumPct   Float
  abcClass String // A | B | C
  eoq      Float?

  createdAt DateTime @default(now())

  @@unique([itemCode, period])
  @@map("ims_abc_snapshot")
  @@schema("public")
}

//-------------------------------------------
//* AUDIT LOG
//-------------------------------------------
model AuditLog {
  id String @id @default(uuid())

  userId     String?
  action     String
  entityType String?
  entityId   String?
  details    Json?

  createdAt DateTime @default(now())

  @@map("ims_audit_log")
  @@schema("public")
}
