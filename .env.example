# Own DB — same physical Supabase project as Purchase-FMS-Supabase
# (ims_* tables live alongside pfms_* tables; app talks to Postgres only
# through the Supabase client / PostgREST, same as OTP_Supabase and
# Purchase-FMS-Supabase's own Supabase usage — no direct Postgres connection
# string needed).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LTO is a genuinely separate Supabase project (also hosts OTP's otp_* tables)
# — read-only access for the sync jobs that pull otp_make_invoice and
# lto_make_quotation_items (real per-line rate/amount for sales value / ABC / EOQ).
LTO_SUPABASE_URL=
LTO_SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for OTP_Supabase's live scan-out call (app/api/integrations/scan-out).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match OTP_Supabase's IMS_API_KEY env var exactly.
INTEGRATION_API_KEY=
